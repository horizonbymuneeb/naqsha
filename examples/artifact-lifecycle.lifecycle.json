    },
    {
      "from": "checked",
      "to": "published",
      "label": "browser passes"
    },
    {
      "from": "checked",
      "to": "lastgood",
      "label": "browser fails"
    },
    {
      "from": "published",
      "to": "candidate",
      "label": "next request"
    },
    {
      "from": "lastgood",
      "to": "candidate",
      "label": "next request"
    }
  ]
